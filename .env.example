# Wallet connect (https://dashboard.reown.com). Wallet-only, email and social stay off.
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cluster. The client only ever talks to devnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Program this frontend reads. Optional until a project deploys one.
NEXT_PUBLIC_PROGRAM_ID=

# Header marks. Both optional.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_CA=
